[include "header.ezt"]
<main class="container py-4">
    <a href="/manage-voters/[eid]">Back to voter list</a>
    <h1 class="mt-3">[title]</h1>
    <p class="lead">[pid] &middot; [election.title]</p>
    [include "flashes.ezt"]
    [if-any error]<div class="alert alert-danger" role="alert">[error]</div>[end]
    [is election.state "editable"]
        <form method="POST" action="/do-set-voter/[eid]/[url_pid]">
            <input type="hidden" name="csrf_token" value="[csrf_token]">
            <fieldset class="mb-3">
                <legend class="h4">Eligible issues</legend>
                [for issues]
                    <label class="d-flex gap-2 align-items-start py-2" for="edit-issue-[issues.iid]">
                        <input id="edit-issue-[issues.iid]" class="form-check-input flex-shrink-0" type="checkbox" name="issue" value="[issues.iid]" [if-any issues.selected]checked[end]>
                        <span>[issues.title]</span>
                    </label>
                [end]
            </fieldset>
            <button type="submit" class="btn btn-primary">Save eligibility</button>
        </form>
        <section class="border-top mt-4 pt-4" aria-labelledby="remove-voter-heading">
            <h2 id="remove-voter-heading" class="h4">Remove voter</h2>
            <p>This removes [pid] from every issue in this election. Their directory record and eligibility in other elections are kept.</p>
            <form method="POST" action="/do-remove-voter/[eid]/[url_pid]">
                <input type="hidden" name="csrf_token" value="[csrf_token]">
                <button type="submit" class="btn btn-outline-danger">Remove voter</button>
            </form>
        </section>
    [else]
        <div class="alert alert-info">This election has opened. Its voter list is frozen and cannot be changed.</div>
        <h2 class="h4">Eligible issues</h2>
        <ul class="list-group">
            [for issues]
                [if-any issues.selected]<li class="list-group-item">[issues.title]</li>[end]
            [end]
        </ul>
    [end]
</main>
[include "footer.ezt"]
